# ---------- Supabase (Project Settings > API) ----------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Chave service_role: NUNCA expor no front-end. Usada só nas rotas /api.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---------- Sessões (gere com: openssl rand -base64 48) ----------
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

# ---------- Senha do admin ----------
# Gere o hash com:  npm run hash -- "SuaSenhaForte"
# ATENÇÃO (.env.local): escape cada "$" do hash como "\$" (o Next expande variáveis).
# Na Vercel (Settings > Environment Variables) cole o hash SEM escapar.
ADMIN_PASSWORD_HASH=REPLACE_WITH_HASH_FROM_NPM_RUN_HASH
# Alternativa simples (menos segura) caso não use o hash:
# ADMIN_PASSWORD=
